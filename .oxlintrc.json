{
  "$schema": "https://raw.githubusercontent.com/oxc-project/oxlint/main/schemas/oxlintrc.json",
  "categories": {
    "correctness": "error",
    "suspicious": "warn",
    "perf": "warn",
    "style": "off",
    "restriction": "off",
    "pedantic": "off"
  },
  "plugins": [
    "typescript",
    "vue"
  ],
  "env": {
    "browser": true,
    "es2021": true
  },
  "settings": {
    "typescript": {
      "tsconfigPath": "./apps/web/tsconfig.app.json"
    }
  },
  "rules": {
    "no-console": "off",
    "@typescript-eslint/no-explicit-any": "warn",
    "@typescript-eslint/no-unused-vars": [
      "warn",
      {
        "argsIgnorePattern": "^_"
      }
    ],
    "no-debugger": "warn",
    "no-eval": "error",
    "no-implied-eval": "error"
  }
}