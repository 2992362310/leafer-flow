{
  "name": "leafer-flow",
  "version": "0.0.0",
  "private": true,
  "packageManager": "pnpm@12.15.0",
  "type": "module",
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "scripts": {
    "typecheck": "pnpm -r typecheck",
    "check:boundaries": "node scripts/check-boundaries.mjs",
    "dev": "pnpm --filter @leafer-flow/web dev",
    "build": "pnpm --filter @leafer-flow/web build",
    "preview": "pnpm --filter @leafer-flow/web preview",
    "lint": "oxlint -c .oxlintrc.json --fix",
    "format": "oxlint -c .oxlintrc.json --fix"
  },
  "devDependencies": {
    "@tsconfig/node22": "^22.0.6",
    "@types/dagre": "^0.7.54",
    "@types/node": "^26.6.5",
    "@vue/tsconfig": "^0.9.1",
    "oxlint": "~1.89.0",
    "typescript": "^6.0.3",
    "vue-tsc": "^3.3.13"
  }
}